{
  "name": "local-projects-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web"],
  "engines": { "node": ">=24.11.0 <25" },
  "scripts": {
    "contracts": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "check": "npm run contracts:check && npm run check --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "dev": "npm run dev --workspace apps/web"
  },
  "devDependencies": { "json-schema-to-typescript": "16.0.0" }
}
