# Daily plans across the Work folder; today comes from the workspace timezone.
GET /api/v1/views/focus-cards?section=motion&folder=Work&limit=200

# Today's timed events, ordered by their start time, with an independent cursor.
GET /api/v1/views/focus-cards?section=events&folder=Work&limit=200

# Actionable attention and unread reports without due-soon reminders.
GET /api/v1/views/attention?focus=true&folder=Work&limit=200

# Pins include bounded daily totals, with an explicit workspace date and card version.
GET /api/v1/workspace/focus

# Record a preview's new absolute total using the containing card's observed version.
# Use the normal CSRF/session and command request ID/epoch headers from card-counter.http.
# After a lost reply retry the identical command; after a conflict explicitly reload.

# Ready motion/event summaries also contain active daily_counters for the workspace
# date and the observed card version, without histories or per-card source reads.
