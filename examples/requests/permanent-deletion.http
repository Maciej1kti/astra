# Protocol examples, not executable credentials. Generate a fresh UUIDv7 and read
# epoch/CSRF from the paired instance. Preserve each original command on retry.
GET https://HOST.TAILNET.ts.net/api/v1/projects/PROJECT_ID/cards/CARD_ID
Cookie: __Host-project_session=REPLACE_FROM_PAIRED_BROWSER

### Delete one card using the version observed above. Unpin/disconnect it first.
DELETE https://HOST.TAILNET.ts.net/api/v1/projects/PROJECT_ID/cards/CARD_ID
Content-Type: application/json
Origin: https://HOST.TAILNET.ts.net
Cookie: __Host-project_session=REPLACE_FROM_PAIRED_BROWSER
X-CSRF-Token: REPLACE_FROM_BOOTSTRAP
X-Request-ID: REPLACE_WITH_FRESH_UUIDV7
X-Command-Epoch: REPLACE_FROM_BOOTSTRAP
If-Match: "r1.REPLACE_WITH_OBSERVED_CARD_HASH"

{}

### Preview the complete .project directory before a separate project deletion.
GET https://HOST.TAILNET.ts.net/api/v1/projects/PROJECT_ID/deletion-plan
Cookie: __Host-project_session=REPLACE_FROM_PAIRED_BROWSER

### Confirm permanent deletion using the preview version, not project.md's version.
DELETE https://HOST.TAILNET.ts.net/api/v1/projects/PROJECT_ID
Content-Type: application/json
Origin: https://HOST.TAILNET.ts.net
Cookie: __Host-project_session=REPLACE_FROM_PAIRED_BROWSER
X-CSRF-Token: REPLACE_FROM_BOOTSTRAP
X-Request-ID: REPLACE_WITH_ANOTHER_FRESH_UUIDV7
X-Command-Epoch: REPLACE_FROM_BOOTSTRAP
If-Match: "r1.REPLACE_WITH_OBSERVED_DELETION_PLAN_HASH"

{}

# Both successful results use status: committed and result.deleted: true.
# If the response is lost or unresolved, query the original command status with
# its epoch. Do not change its request ID, payload or precondition on retry.
# Changed previews require reviewing a new deletion scope before a new intention.
