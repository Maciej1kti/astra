# All values below are illustrative. Obtain current profile IDs, epochs, cookies
# and CSRF tokens from your host; use a fresh request UUIDv7 for a new intention.

GET /api/v1/users HTTP/1.1
Cookie: __Host-project_session=EXAMPLE
X-Astra-User: 77777777-7777-4777-8777-777777777777

### Create a profile through the default Owner's command journal.
# Retain the entire payload, default profile, request ID and epoch on retry.
POST /api/v1/users HTTP/1.1
Content-Type: application/json
Cookie: __Host-project_session=EXAMPLE
X-CSRF-Token: EXAMPLE
X-Astra-User: 11111111-1111-4111-8111-111111111111
X-Request-ID: 019913e8-8000-7000-8000-000000000001
X-Command-Epoch: 44444444-4444-4444-8444-444444444444

{"id":"77777777-7777-4777-8777-777777777777","name":"Ania"}

### Read the selected profile's bootstrap, folders, projects and preferences.
GET /api/v1/bootstrap HTTP/1.1
Cookie: __Host-project_session=EXAMPLE
X-Astra-User: 77777777-7777-4777-8777-777777777777

### EventSource selects the same profile through its URL.
GET /api/v1/events?user_id=77777777-7777-4777-8777-777777777777 HTTP/1.1
Cookie: __Host-project_session=EXAMPLE

### An uncertain user creation is resolved against the default profile.
GET /api/v1/commands/019913e8-8000-7000-8000-000000000001?epoch=44444444-4444-4444-8444-444444444444 HTTP/1.1
Cookie: __Host-project_session=EXAMPLE
X-Astra-User: 11111111-1111-4111-8111-111111111111
