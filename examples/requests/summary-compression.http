# Existing paired session cookies are managed by the client, not copied here.
# The browser transparently decodes gzip; the decoded schema and versions are unchanged.
GET /api/v1/views/calendar?from=2026-09-01&to=2026-09-30&limit=1000
Accept-Encoding: gzip

# A sufficiently large response includes:
# Content-Type: application/json
# Content-Encoding: gzip
# Vary: Accept-Encoding
# Cache-Control: no-store
# Content-Length: <encoded byte count>

# CLI/older clients can explicitly retain identity JSON.
GET /api/v1/workspace/focus
Accept-Encoding: identity

# Source reads retain their strong ETag and identity body even when gzip is requested.
GET /api/v1/projects/11111111-1111-4111-8111-111111111111/cards/22222222-2222-4222-8222-222222222222
Accept-Encoding: gzip

# No acceptable supported representation returns 406 ENCODING_NOT_ACCEPTABLE.
GET /api/v1/views/list?type=card
Accept-Encoding: br, identity;q=0
