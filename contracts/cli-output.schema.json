{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI result envelope",
  "description": "Default projectctl stdout envelope, also selected by --json or --output json. Optional --output text is human presentation and does not use this JSON schema. Exit codes and command identity semantics are unchanged by presentation.",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "1"
    },
    "ok": {
      "type": "boolean"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "command_epoch": {
      "type": [
        "string",
        "null"
      ]
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "data": {},
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "api_version",
    "ok",
    "request_id"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "data"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "data"
        ]
      }
    }
  ],
  "$defs": {
    "FocusPreview": {
      "type": "object",
      "description": "Read-only focus-preview data. Successful Focus availability does not certify all sources or HTTPS.",
      "properties": {
        "online": {
          "const": true
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cards": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "status": {
                "type": "string",
                "maxLength": 40
              },
              "available": {
                "type": "boolean"
              }
            },
            "required": [
              "title",
              "status",
              "available"
            ],
            "additionalProperties": false
          }
        },
        "message": {
          "const": "Local API reachable"
        }
      },
      "required": [
        "online",
        "total",
        "cards",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
