{
  "protocol": "HTTP/1.1 over Unix domain socket",
  "version": 1,
  "authentication": "peer UID equals service UID; 0700 directory and 0600 socket",
  "tcp_mount_forbidden": true,
  "common_api": "/api/v1 resources: same dispatcher, Principal::LocalUid, CSRF exemption only for this transport",
  "routes": [
    {
      "method": "GET",
      "path": "/local/v1/hello",
      "input": null,
      "output": [
        "instance_id",
        "command_epoch",
        "server_time",
        "api_version"
      ]
    },
    {
      "method": "POST",
      "path": "/local/v1/registration-plans",
      "input": {
        "absolute_path": "string",
        "name": "optional string",
        "git_mode": "private|tracked"
      },
      "output": "RegistrationPlan"
    },
    {
      "method": "POST",
      "path": "/local/v1/pairings/{pairing_id}/approve",
      "input": {
        "challenge": "string"
      },
      "output": "Pairing"
    },
    {
      "method": "POST",
      "path": "/local/v1/pairings/{pairing_id}/deny",
      "input": {},
      "output": "Pairing"
    },
    {
      "method": "POST",
      "path": "/local/v1/roots",
      "input": {
        "absolute_path": "string",
        "label": "string"
      },
      "output": "Root"
    },
    {
      "method": "DELETE",
      "path": "/local/v1/roots/{root_id}",
      "input": {},
      "output": {
        "removed": "boolean"
      }
    },
    {
      "method": "POST",
      "path": "/local/v1/maintenance/plans",
      "input": {
        "operation": "normalize|rebalance|relocate|unregister|index_rebuild",
        "fields": "strict flattened variant in maintenance_parameters"
      },
      "output": {
        "plan_id": "UUID",
        "steps": "array",
        "warnings": "array",
        "expires_at": "Instant"
      }
    },
    {
      "method": "POST",
      "path": "/local/v1/maintenance/jobs",
      "input": {
        "plan_id": "UUID",
        "request_id": "UUIDv7",
        "command_epoch": "UUID"
      },
      "output": "Accepted"
    },
    {
      "method": "GET",
      "path": "/local/v1/doctor",
      "input": null,
      "output": "redacted Diagnostics"
    },
    {
      "method": "POST",
      "path": "/local/v1/projects/resolve",
      "input": {
        "absolute_path": "exact absolute registered path"
      },
      "output": {
        "project_id": "UUID"
      },
      "read_only": true
    }
  ],
  "maintenance_parameters": {
    "normalize": {
      "project_id": "UUID",
      "kind": "project|card|milestone|update",
      "id": "UUID",
      "expected_version": "Version"
    },
    "rebalance": {
      "project_id": "UUID",
      "kind": "card|milestone",
      "expected_projection_revision": "opaque cursor"
    },
    "relocate": {
      "project_id": "UUID",
      "new_absolute_path": "exact absolute path of already moved/copied project",
      "expected_workspace_version": "Version"
    },
    "unregister": {
      "project_id": "UUID",
      "expected_workspace_version": "Version"
    },
    "index_rebuild": {
      "project_id": "UUID"
    }
  },
  "notes": [
    "Plan is no destructive action. Commit rechecks preconditions.",
    "Maintenance API is internal, not offered to unauthenticated loopback or remote browser.",
    "Schema variants must be implemented as strict tagged unions, not unrestricted maps.",
    "Built-in backup/restore archives and source-file migrations are deferred by the owner on 2026-09-05."
  ]
}
