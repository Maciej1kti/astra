{
  "schemaVersion": 1,
  "id": "astra.focus",
  "name": "Astra Hosts",
  "version": "0.2.0",
  "author": "Astra",
  "description": "Switch between Astra hosts, see whether the selected one answers, and open it.",
  "kinds": ["bar-widget"],
  "entryPoints": {"barWidget": "Widget.qml"},
  "barWidget": {
    "displayName": "Astra Hosts",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {"hosts": "", "activeHost": ""},
    "schema": [
      {"key": "hosts", "type": "string", "label": "Astra hosts, separated by commas"},
      {"key": "activeHost", "type": "string", "label": "Selected host address"}
    ]
  }
}
